{
  "__PLACEHOLDER__": true,
  "__INSTRUCTIONS__": [
    "1. Go to https://console.firebase.google.com/",
    "2. Create a new project (or use existing)",
    "3. Add an Android app with package name: com.audiobookapp",
    "4. Download the real google-services.json",
    "5. Replace THIS file with the downloaded one",
    "6. In Firebase Console > Authentication > Sign-in method > enable Google",
    "7. Add your debug SHA-1 fingerprint:",
    "   Run: keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android -keypass android",
    "   Copy the SHA1 and paste it in Firebase Console > Project Settings > Your apps > Add fingerprint"
  ],
  "project_info": {
    "project_number": "REPLACE_WITH_PROJECT_NUMBER",
    "project_id": "REPLACE_WITH_PROJECT_ID",
    "storage_bucket": "REPLACE_WITH_PROJECT_ID.appspot.com"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "REPLACE_WITH_APP_ID",
        "android_client_info": {
          "package_name": "com.audiobookapp"
        }
      },
      "oauth_client": [
        {
          "client_id": "REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com",
          "client_type": 3
        }
      ],
      "api_key": [
        {
          "current_key": "REPLACE_WITH_API_KEY"
        }
      ],
      "services": {
        "appinvite_service": {
          "other_platform_oauth_client": []
        }
      }
    }
  ],
  "configuration_version": "1"
}
